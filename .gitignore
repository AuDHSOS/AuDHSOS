# The fuzzer writes what it discovers into the same directories the
# regression corpus lives in, naming every input by a hash of its content.
# Those hexadecimal names are the mark: the regression corpus of D-54 is
# named in words, one file per case a test cites, and is tracked; what a
# run finds is reproducible by another run and is not. Thirty-two
# characters is this project's own engine, forty is libFuzzer, which wrote
# into these directories before the engine took its place.
fuzz/corpus/*/????????????????????????????????
fuzz/corpus/*/????????????????????????????????????????

# macOS leaves these beside anything a Finder window has opened.
.DS_Store

# The coding agent's directory. `.claude/settings.json` is the project's
# own configuration and is tracked; what a session writes is not.
# `.claude/worktrees/` holds whole further checkouts of this repository,
# one per worktree session, and `settings.local.json` holds the
# permissions one machine granted.
.claude/worktrees/
.claude/settings.local.json

# other cloned git repos with operating systems
/research/

# libFuzzer writes a failing input beside the target it found it with.
crash-*
